#: front/action.php:64
msgid "Select some sources and choose a classification."
msgstr "Marque alguna fuente y elija una clasificación."

#: front/action.php:88
#, php-format
msgid "%1$d source(s) classified as \"%2$s\"."
msgstr "%1$d fuente(s) clasificada(s) como «%2$s»."

#: front/action.php:111
msgid "None of the selected mails can be read again from the mailbox (the folder changed or nothing is selected)."
msgstr "Ningún correo marcado se puede volver a leer del buzón (la carpeta ha cambiado o no hay marcados)."

#: front/action.php:118
msgid "A collection is already running in the background. Its progress is shown in the Collection tab."
msgstr "Ya hay una recogida en marcha en segundo plano. Su avance se ve en la pestaña Recogida."

#: front/action.php:123
msgid "Collection started in the background. You can keep using GLPI; the progress is shown in the Collection tab."
msgstr "Recogida iniciada en segundo plano. Puede seguir usando GLPI; el avance se ve en la pestaña Recogida."

#: front/action.php:125
msgid "This server cannot start background processes: the next \"collect\" automatic action will do the collection."
msgstr "Este servidor no permite lanzar procesos en segundo plano: la recogida la hará la próxima acción automática «collect»."

#: front/action.php:132
msgid "No file was uploaded."
msgstr "No se ha subido ningún fichero."

#: front/action.php:154
msgid "No file could be saved."
msgstr "No se ha podido guardar ningún fichero."

#: front/action.php:159
#, php-format
msgid "%d file(s) queued: the job already running will import them when it ends."
msgstr "%d fichero(s) en cola: los importará el trabajo que ya está en marcha al terminar."

#: front/action.php:161
#, php-format
msgid "%d file(s) received: they are imported in the background. The progress is shown in the Collection tab."
msgstr "%d fichero(s) recibidos: se importan en segundo plano. El avance se ve en la pestaña Recogida."

#: front/action.php:163
#, php-format
msgid "%d file(s) queued: the next \"collect\" automatic action will import them."
msgstr "%d fichero(s) en cola: los importará la próxima acción automática «collect»."

#: front/action.php:168
msgid "Unknown action."
msgstr "Acción desconocida."

#: front/config.form.php:72
msgid "The start date is not valid; it was not changed."
msgstr "La fecha de inicio no es válida; no se ha cambiado."

#: front/config.form.php:78
msgid "The destination folder cannot be the reports folder: read-only mode is kept."
msgstr "La carpeta de destino no puede ser la misma que la de los informes: se deja en solo lectura."

#: front/config.form.php:119
msgid "The OAuth client ID should end with \".apps.googleusercontent.com\"; it was saved as given."
msgstr "El ID de cliente OAuth debería terminar en «.apps.googleusercontent.com»; se ha guardado tal cual."

#: front/config.form.php:139
msgid "The mailbox account changed: the previous Google connection was discarded. Press \"Connect with Google\" again."
msgstr "Ha cambiado la cuenta del buzón: la conexión con Google anterior se ha descartado. Vuelva a pulsar «Conectar con Google»."

#: front/config.form.php:144
msgid "Disconnected from Google. To remove the permission in Google too: myaccount.google.com › Security › Third-party connections."
msgstr "Desconectado de Google. Para quitar también el permiso en Google: myaccount.google.com › Seguridad › Conexiones con terceros."

#: front/config.form.php:163
msgid "Configuration saved."
msgstr "Configuración guardada."

#: front/oauth.callback.php:57
msgid "Save the OAuth client ID and secret first."
msgstr "Guarde antes el ID y el secreto del cliente OAuth."

#: front/oauth.callback.php:74
msgid "The authorization was cancelled in Google."
msgstr "Se ha cancelado la autorización en Google."

#: front/oauth.callback.php:75
#, php-format
msgid "Google returned an error: %s"
msgstr "Google ha devuelto un error: %s"

#: front/oauth.callback.php:85
msgid "The answer from Google does not belong to a connection started here. Press \"Connect with Google\" again."
msgstr "La respuesta de Google no corresponde a una conexión iniciada desde aquí. Pulse de nuevo «Conectar con Google»."

#: front/oauth.callback.php:96
msgid "Google did not say which account was authorized."
msgstr "Google no ha indicado qué cuenta ha autorizado."

#: front/oauth.callback.php:100
#, php-format
msgid "You authorized the account %1$s, but the configured mailbox is %2$s. Nothing was saved: connect again with the mailbox account."
msgstr "Ha autorizado la cuenta %1$s, pero el buzón configurado es %2$s. No se ha guardado nada: vuelva a conectar con la cuenta del buzón."

#: front/oauth.callback.php:110
#, php-format
msgid "Connected with Google as %s. You can now test the connection."
msgstr "Conectado con Google como %s. Ya puede probar la conexión."

